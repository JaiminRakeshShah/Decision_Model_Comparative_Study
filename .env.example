# Live four-model comparison. compare.py reads this file.
# The frozen results.json / analyze.py pair is unchanged.

COMPARE_MODELS=jev-latest,kev-latest,laya-english,gpt-6-luna

# Hosted Jev (System One). Required for jev-latest.
TYPESAFE_API_KEY=

# OpenAI Decisions API. Required for gpt-6-luna. The adapter translates
# System One choice and noul into Decisions choice and predicate.
OPENAI_API_KEY=

# On the Mac these are localhost. Inside Docker use host.docker.internal.
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
KEV_BASE_URL=http://127.0.0.1:8008/v1/systemone
LAYA_BASE_URL=http://127.0.0.1:8010/v1/systemone
OPENAI_DECISIONS_URL=https://api.openai.com/v1/decisions
